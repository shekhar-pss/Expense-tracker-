# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (leave DB_ENGINE blank / sqlite for local dev)
DB_ENGINE=sqlite
DB_NAME=expenseflow
DB_USER=expenseflow
DB_PASSWORD=expenseflow
DB_HOST=db
DB_PORT=5432

# Email (console backend by default - prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@expenseflow.local

# Currency default
DEFAULT_CURRENCY=INR
